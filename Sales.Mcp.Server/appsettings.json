{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RateLimiting": {
    "McpEndpoint": {
      "PermitLimit": 100,
      "WindowInMinutes": 1,
      "QueueLimit": 5
    }
  },
  "Mcp": {
    "AllowedOrigins": "",
    "RequestTimeoutSeconds": 30,
    "MaxPageSize": 100,
    "MaxRequestBodyBytes": 131072
  }
}
